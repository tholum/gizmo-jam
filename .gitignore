# Godot 4 — generated import cache, shader cache and editor state.
# (*.import and *.uid files next to assets/scripts ARE tracked: Godot needs them.)
.godot/
.import/
*.translation
export_credentials.cfg
android/

# Local Godot editor/engine binaries and export templates
.tools/

# Raspberry Pi SD image builder output: downloads, built images, local config
# with secrets. The builder itself is tracked in tools/pi-image/.
.pi-image/

# Export output — rebuild with tools/build.py
builds/

# Test screenshots, logs and probe output — regenerated by tests/
test-output/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Secrets — keys are read from the environment or ~/.config, never from the repo
.env
.env.*
*.key
*.pem

# Editors and OS
.vscode/
.idea/
*.swp
*~
*.tmp
.DS_Store
Thumbs.db
desktop.ini

# Agent/tool local state
.claude/settings.local.json
.claude/worktrees/
