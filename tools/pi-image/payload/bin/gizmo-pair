APP_JS = r"""
"use strict";
const $ = (id) => document.getElementById(id);
let state = null, scanTotal = 20, armedForget = null, timer = null;

function el(tag, cls, text) {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  if (text !== undefined) e.textContent = text;
  return e;
}
function tag(text, cls) { return el("span", "tag" + (cls ? " " + cls : ""), text); }
function say(text, err) { const s = $("status"); s.textContent = text || ""; s.className = "status" + (err ? " err" : ""); }

async function post(path, body) {
  try {
    const r = await fetch(path, { method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body || {}) });
    const j = await r.json().catch(() => ({}));
    if (!r.ok || !j.ok) { say(j.error || ("Request failed (" + r.status + ")"), true); return false; }
    say(j.message || "");
    return true;
  } catch (e) { say("The Pi did not answer. Is it on the same network?", true); return false; }
  finally { refresh(); }
}

function deviceName(d) { return d.name || d.address; }

function jobLine(d) {
  const j = state && state.jobs ? state.jobs[d.address] : null;
  return j ? el("div", "job " + j.state, j.message) : null;
}

function button(text, cls, fn, disabled) {
  const b = el("button", cls, text);
  b.disabled = !!disabled;
  b.addEventListener("click", fn);
  return b;
}

function renderPads() {
  const box = $("pads"); box.replaceChildren();
  const pads = state.pads || [];
  if (!pads.length) { box.append(el("div", "empty", "No controllers yet. Plug one into USB or pair one below.")); return; }
  pads.forEach((p, i) => {
    const row = el("div", "row"), who = el("div", "who");
    const n = el("div", "name"); n.append(tag("P" + (i + 1), "on"), document.createTextNode(p.name));
    who.append(n, el("div", "meta", p.bus + " · " + p.id + (p.address ? " · " + p.address : "")));
    row.append(who); box.append(row);
  });
}

function renderPaired() {
  const box = $("paired"); box.replaceChildren();
  const busy = Object.values(state.jobs || {}).some((j) => j.state === "working");
  const list = (state.devices || []).filter((d) => d.paired);
  if (!state.available) { box.append(el("div", "empty", "No Bluetooth adapter found on this Pi.")); return; }
  if (!state.adapter.powered) {
    const row = el("div", "row"), who = el("div", "who");
    who.append(el("div", "name", "Bluetooth is off"), el("div", "meta", state.adapter.power_state || ""));
    row.append(who, button("TURN ON", "primary", () => post("/api/power")));
    box.append(row); return;
  }
  if (!list.length) { box.append(el("div", "empty", "None yet.")); return; }
  for (const d of list) {
    const row = el("div", "row"), who = el("div", "who"), btns = el("div", "btns");
    const n = el("div", "name");
    n.append(tag(d.connected ? "CONNECTED" : "ASLEEP", d.connected ? "on" : ""), document.createTextNode(deviceName(d)));
    who.append(n, el("div", "meta", d.address + (d.gamepad ? "" : " · not a game controller")));
    if (d.connected) btns.append(button("DISCONNECT", "ghost", () => post("/api/disconnect", { address: d.address }), busy));
    else btns.append(button("CONNECT", "", () => post("/api/connect", { address: d.address }), busy));
    const armed = armedForget === d.address;
    btns.append(button(armed ? "TAP AGAIN TO FORGET" : "FORGET", armed ? "danger" : "ghost", () => {
      if (armedForget === d.address) { armedForget = null; post("/api/forget", { address: d.address }); }
      else { armedForget = d.address; render(); setTimeout(() => { if (armedForget === d.address) { armedForget = null; render(); } }, 4000); }
    }, busy));
    row.append(who, btns);
    const j = jobLine(d); if (j) row.append(j);
    box.append(row);
  }
}

function renderFound() {
  const box = $("found"); box.replaceChildren();
  const others = $("others").checked;
  const busy = Object.values(state.jobs || {}).some((j) => j.state === "working");
  const list = (state.devices || []).filter((d) => !d.paired && (others || d.gamepad || (state.jobs || {})[d.address]));
  const hidden = (state.devices || []).filter((d) => !d.paired && !d.gamepad).length;
  box.hidden = !list.length && !state.scanning && !hidden;
  if (!list.length) {
    const note = hidden && !others ? " " + hidden + " other device(s) nearby don’t look like controllers (tick “show other devices”)." : "";
    box.append(el("div", "empty", (state.scanning ? "Looking… keep the controller in pairing mode." : "No controllers found yet.") + note));
    return;
  }
  for (const d of list) {
    const row = el("div", "row"), who = el("div", "who");
    const n = el("div", "name");
    if (d.gamepad) n.append(tag("PAD", "warn"));
    n.append(document.createTextNode(deviceName(d)));
    who.append(n, el("div", "meta", d.address + (d.rssi !== null ? " · signal " + d.rssi + " dBm" : "")));
    row.append(who, button("PAIR", "primary", () => post("/api/pair", { address: d.address }), busy));
    const j = jobLine(d); if (j) row.append(j);
    box.append(row);
  }
}

function renderScan() {
  const s = state.scanning, b = $("scan");
  $("bar").hidden = !s;
  if (s) {
    $("scanText").textContent = "Scanning… " + s + " s";
    $("barFill").style.width = Math.round(100 * (1 - s / scanTotal)) + "%";
    b.textContent = "STOP"; b.className = "ghost";
  } else {
    $("scanText").textContent = "Put the controller in pairing mode, then scan.";
    b.textContent = "SCAN"; b.className = "primary";
  }
  b.disabled = !state.available;
}

function render() {
  if (!state) return;
  $("host").textContent = state.hostname || "this Pi";
  renderPads(); renderPaired(); renderScan(); renderFound();
}

async function refresh() {
  clearTimeout(timer);
  try {
    const r = await fetch("/api/state", { cache: "no-store" });
    if (r.ok) state = await r.json();
    render();
  } catch (e) { say("Lost contact with the Pi; retrying…", true); }
  const fast = state && (state.scanning || Object.values(state.jobs || {}).some((j) => j.state === "working"));
  timer = setTimeout(refresh, fast ? 1000 : 2500);
}

$("scan").addEventListener("click", () => {
  if (state && state.scanning) post("/api/scan/stop"); else { scanTotal = 20; post("/api/scan"); }
});
$("others").addEventListener("change", render);
refresh();
"""


if __name__ == "__main__":
    sys.exit(main())
