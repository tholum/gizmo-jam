## Announcer voice lines and sound effects for Gizmo Jam.
##
## Usage (from main.gd):
##     var audio = preload("res://scripts/audio.gd").new()
##     add_child(audio)
##     audio.voice("go")
##     audio.sfx("jump", randf_range(0.95, 1.05))
##
## Assets live in res://assets/audio/{voice,sfx}/<id>.ogg and are regenerated by
## tools/generate_audio.py (ElevenLabs). A .wav or .mp3 with the same id is also
## accepted. Missing files never crash: a warning is pushed once per id.
## In headless runs (DisplayServer "headless") every call is a no-op.
##
## Voice ids (announcer, one line at a time; a new line interrupts the old one):
##   welcome        "Welcome to Gizmo Jam!"
##   game_spin_cycle  "Spin Cycle!"
##   three          "Three!"
##   two            "Two!"
##   one            "One!"
##   go             "Go!"
##   accelerating   "Speeding up!"          (ACCELERATING phase, 25 s)
##   overdrive      "Overdrive!"            (OVERDRIVE phase, 60 s)
##   youre_out      "You're out!"
##   last_two       "Down to the final two!"
##   winner         "We have a champion!"
##   you_win        "You win!"
##   draw           "It's a draw!"
##   streak         "On fire!"
##   lobby          "Waiting for players."
##   player_joined  "New challenger!"
##   rematch        "Run it back!"
##   game_livewire  "Live Wire!"
##   surge          "Surge incoming!"       (Live Wire: a surge is charging)
##   zapped         "Zapped!"               (Live Wire: you were shocked)
##   locked         "Locked in!"            (Live Wire: a loop was closed)
##   ten_seconds    "Ten seconds!"
##   time_up        "Time's up!"
##
## SFX ids (pooled, can overlap):
##   ui_hover        very short soft tick
##   ui_click        button confirm
##   ui_back         back / cancel
##   countdown_tick  3-2-1 beep
##   countdown_go    start horn
##   jump            hop whoosh
##   duck            quick slide
##   clear           bright positive blip (obstacle cleared)
##   hit             zap impact
##   eliminated      power-down
##   rod_warn        subtle ping before a rod crosses
##   victory         ~3 s fanfare sting
##   round_start     whoosh into impact
##   dash            quick whoosh burst (Live Wire dash)
##   shove           short body-check thud
##   zap             electric shock hit on a player
##   claim           tiny soft tile tick (very short and quiet: fires several times a second)
##   loop_lock       bright rising lock-in chime
##   surge_warn      ~1.4 s rising electrical charge-up hum
##   surge_fire      ~0.5 s sharp electric beam blast
##
## music(on) is a no-op: no music loop is shipped yet.
extends Node

const VOICE_DIR := "res://assets/audio/voice/"
const SFX_DIR := "res://assets/audio/sfx/"
const EXTENSIONS := ["ogg", "wav", "mp3"]

const VOICE_IDS: Array[String] = [
	"welcome", "game_spin_cycle", "three", "two", "one", "go", "accelerating",
	"overdrive", "youre_out", "last_two", "winner", "you_win", "draw",
	"streak", "lobby", "player_joined", "rematch",
	"game_livewire", "surge", "zapped", "locked", "ten_seconds", "time_up",
]
const SFX_IDS: Array[String] = [
	"ui_hover", "ui_click", "ui_back", "countdown_tick", "countdown_go", "jump",
	"duck", "clear", "hit", "eliminated", "rod_warn", "victory", "round_start",
	"dash", "shove", "zap", "claim", "loop_lock", "surge_warn", "surge_fire",
]

## Seconds before the same voice line may play again.
const VOICE_COOLDOWN := 1.2
## Seconds before the same SFX may retrigger (stops hover/rod_warn machine-gunning).
const SFX_MIN_INTERVAL := 0.03
const SFX_POOL_SIZE := 10

## When false, everything is silent and anything playing is stopped.
var enabled := true:
	set(value):
		enabled = value
		if not enabled:
			stop_all()

var voice_volume_db := 0.0:
	set(value):
		voice_volume_db = value
		if _voice_player:
			_voice_player.volume_db = value
var sfx_volume_db := -2.0

var _active := false
var _initialized := false
var _voice_streams := {}
var _sfx_streams := {}
var _voice_player: AudioStreamPlayer
var _sfx_pool: Array[AudioStreamPlayer] = []
var _sfx_started: Array[int] = []
var _voice_last := {}
var _sfx_last := {}
var _warned := {}


func _ready() -> void:
	_init_audio()


## Play an announcer line. Interrupts the current line; the same id is ignored
## if it played less than VOICE_COOLDOWN seconds ago.
func voice(id: String) -> void:
	if not enabled or not is_inside_tree() or not _init_audio():
		return
	var stream: AudioStream = _voice_streams.get(id)
	if stream == null:
		_warn_once("voice:" + id, "audio.gd: no voice stream for id '%s'" % id)
		return
	var now := Time.get_ticks_msec()
	if _voice_last.has(id) and now - int(_voice_last[id]) < int(VOICE_COOLDOWN * 1000.0):
		return
	_voice_last[id] = now
	_voice_player.stop()
	_voice_player.stream = stream
	_voice_player.play()


## Play a sound effect on a pooled player so overlaps work. `pitch` scales
## playback speed (clamped to 0.25..4.0).
func sfx(id: String, pitch: float = 1.0) -> void:
	if not enabled or not is_inside_tree() or not _init_audio():
		return
	var stream: AudioStream = _sfx_streams.get(id)
	if stream == null:
		_warn_once("sfx:" + id, "audio.gd: no sfx stream for id '%s'" % id)
		return
	var now := Time.get_ticks_msec()
	if _sfx_last.has(id) and now - int(_sfx_last[id]) < int(SFX_MIN_INTERVAL * 1000.0):
		return
	_sfx_last[id] = now
	var index := _free_sfx_slot()
	var player := _sfx_pool[index]
	player.stop()
	player.stream = stream
	player.pitch_scale = clampf(pitch, 0.25, 4.0)
	player.volume_db = sfx_volume_db
	player.play()
	_sfx_started[index] = now


## Optional background music. No loop is shipped, so this is a no-op.
func music(_on: bool) -> void:
	pass


## Stop the current voice line and every playing sound effect.
func stop_all() -> void:
	if _voice_player:
		_voice_player.stop()
	for player in _sfx_pool:
		player.stop()


## True when a stream for this voice or sfx id was loaded.
func has_sound(id: String) -> bool:
	_init_audio()
	return _voice_streams.has(id) or _sfx_streams.has(id)


## res:// path of the first existing file for `id` in `dir`, or "" if none.
static func resolve_path(dir: String, id: String) -> String:
	for ext in EXTENSIONS:
		var path: String = dir + id + "." + ext
		if ResourceLoader.exists(path):
			return path
	return ""


func _init_audio() -> bool:
	if _initialized:
		return _active
	_initialized = true
	_active = DisplayServer.get_name() != "headless"
	if not _active:
		return false
	_voice_player = AudioStreamPlayer.new()
	_voice_player.name = "AnnouncerVoice"
	_voice_player.volume_db = voice_volume_db
	add_child(_voice_player)
	for i in SFX_POOL_SIZE:
		var player := AudioStreamPlayer.new()
		player.name = "Sfx%d" % i
		add_child(player)
		_sfx_pool.append(player)
		_sfx_started.append(0)
	_load_all(VOICE_DIR, VOICE_IDS, _voice_streams)
	_load_all(SFX_DIR, SFX_IDS, _sfx_streams)
	return true


func _load_all(dir: String, ids: Array[String], into: Dictionary) -> void:
	for id in ids:
		var path := resolve_path(dir, id)
		if path == "":
			_warn_once("file:" + dir + id, "audio.gd: missing audio file %s%s.(ogg|wav|mp3)" % [dir, id])
			continue
		var stream := load(path) as AudioStream
		if stream == null:
			_warn_once("file:" + path, "audio.gd: could not load %s" % path)
			continue
		into[id] = stream


func _free_sfx_slot() -> int:
	var oldest := 0
	for i in _sfx_pool.size():
		if not _sfx_pool[i].playing:
			return i
		if _sfx_started[i] < _sfx_started[oldest]:
			oldest = i
	return oldest


func _warn_once(key: String, message: String) -> void:
	if _warned.has(key):
		return
	_warned[key] = true
	push_warning(message)
